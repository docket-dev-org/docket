{
  "_meta": {
    "schema": "docket/prices/v1",
    "as_of": "2026-10-13",
    "currency": "USD",
    "unit": "per_million_tokens",
    "note": "List prices for public APIs, used to ESTIMATE cost from token counts reported by the provider. Docket never bills anyone and never claims these are the prices you pay: negotiated, regional, batch, flex, priority and subscription pricing all differ. Amounts are strings to keep verification reproducible across languages.",
    "sources": [
      "https://developers.openai.com/api/docs/pricing",
      "https://www.anthropic.com/pricing",
      "https://ai.google.dev/gemini-api/docs/pricing",
      "https://api-docs.deepseek.com/quick_start/pricing"
    ],
    "matched_by": "fnmatch-style glob, case-insensitive, FIRST MATCH IN FILE ORDER WINS, so narrower families must be listed before wider ones (see gpt-6-luna* before gpt-6*)"
  },
  "families": [
    {
      "pattern": "gpt-6-luna*",
      "input": "0.10",
